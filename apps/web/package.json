{
  "name": "exam-engine-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle.mjs dist"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.16.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.13.0",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.0",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
