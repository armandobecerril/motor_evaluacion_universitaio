# Solo ejemplo. Copia a apps/api/.env y NUNCA subas valores reales.

# --- API (FastAPI) ---
APP_ENV=local
BUILD_SHA=dev
# Rol de aplicación (DML, sujeto a RLS). En Azure: sslmode=require
DATABASE_URL=postgresql+psycopg://exam_app:CAMBIAR@localhost:5432/exam_dev
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_S=10
DB_STATEMENT_TIMEOUT_MS=5000

# Secreto para HMAC de códigos de acceso de examen (Key Vault en Azure). Genera uno largo y aleatorio:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_CODE_PEPPER=CAMBIAR

# Rol propietario del esquema, solo para Alembic (no lo usa la API)
MIGRATION_DATABASE_URL=postgresql+psycopg://exam_owner:CAMBIAR@localhost:5432/exam_dev

# Pruebas de integración (BD DESECHABLE: se borra y recrea)
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://exam_owner:CAMBIAR@localhost:5432/exam_test
TEST_DATABASE_URL=postgresql+psycopg://exam_app:CAMBIAR@localhost:5432/exam_test

# --- Web (Vite) ---
VITE_API_BASE_URL=/api

# --- Azure (se llenan en H5; los usa el operador, no la app) ---
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=southcentralus
APPLICATIONINSIGHTS_CONNECTION_STRING=
